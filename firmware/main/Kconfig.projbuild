menu "CITS-to-go firmware"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config HW_VARIANT
        string "Hardware variant"
        default "seeed-xiao-esp32c5"
        help
            Hardware identifier emitted in CITSMETA. CITS-to-go currently
            targets the Seeed Studio XIAO ESP32-C5.

    config CITS_DEFAULT_FREQUENCY_MHZ
        int "Default ITS-G5 frequency in MHz"
        range 5800 5900
        default 5900
        help
            Frequency used by sniffer_autostart() when no NVS override exists.
            G5CC is 5900 MHz.

    config CITS_BROADCAST_ONLY
        bool "Capture broadcast 802.11 frames only"
        default y
        help
            Ignore non-broadcast frames before serial logging. This matches the
            intended C-ITS receive path and reduces USB/MQTT load.

    config CITS_ENABLE_USB_SERIAL_LOG
        bool "Stream captured C-ITS packets over USB serial"
        default y
        help
            Emits accepted C-ITS packets over the ESP-IDF console, normally
            USB Serial/JTAG on the XIAO ESP32-C5.

    config CITS_USB_SERIAL_LOG_GEONET_ONLY
        bool "Only serial-log ETSI GeoNetworking EtherType 0x8947 frames"
        depends on CITS_ENABLE_USB_SERIAL_LOG
        default y
        help
            Filters to 802.11 data frames carrying LLC/SNAP EtherType 0x8947.
            Disable only when debugging PHY/channel capture.

    config CITS_USB_SERIAL_LOG_MAX_LEN
        int "Maximum bytes logged per serial packet"
        depends on CITS_ENABLE_USB_SERIAL_LOG
        range 64 4096
        default 4096
        help
            Longer frames are truncated before serial output.

    config CITS_RX_LED_PULSE_MS
        int "C-ITS receive LED blink duration in milliseconds"
        range 10 1000
        default 60
        help
            Pulse duration for the XIAO USER LED after each accepted packet.

    config CITS_USER_LED_GPIO
        int "XIAO ESP32-C5 USER LED GPIO"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 27
        help
            The Seeed Studio XIAO ESP32-C5 onboard L/USER LED is GPIO27.

    config CITS_USER_LED_ACTIVE_LOW
        bool "XIAO ESP32-C5 USER LED is active-low"
        default y
        help
            The XIAO USER LED turns on when GPIO27 is driven low.

    config SNIFFER_WORK_QUEUE_LEN
        int "Length of sniffer work queue"
        range 8 1024
        default 128
        help
            Packets are copied from the Wi-Fi callback into this queue before
            serial logging. Increase this if USB logging bursts cause drops.

    config SNIFFER_TASK_STACK_SIZE
        int "Stack size of sniffer task"
        range 2048 16384
        default 4096
        help
            Stack size for the packet processing task.

    config SNIFFER_TASK_PRIORITY
        int "Priority of sniffer task"
        range 1 20
        default 2
        help
            FreeRTOS priority for the packet processing task.

endmenu
