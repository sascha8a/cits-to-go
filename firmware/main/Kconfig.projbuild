menu "CITS-to-go Configuration"

    config CITS_RX_FREQUENCY_MHZ
        int "C-ITS receive frequency in MHz"
        range 5860 5900
        default 5900
        help
            ITS-G5 channel center frequency. Common values are 5900 for G5CC,
            5890 for G5SC2, 5880 for G5SC1, 5870 for G5SC3, and 5860 for G5SC4.

    config CITS_BROADCAST_ONLY
        bool "Capture only broadcast 802.11 frames"
        default y
        help
            C-ITS messages are normally sent to the broadcast destination
            address. Filtering here reduces serial bandwidth and CPU work.

    config CITS_PACKET_POOL_SIZE
        int "Packet buffer pool size"
        range 4 64
        default 16
        help
            Number of fixed packet buffers available to the Wi-Fi receive
            callback.

    config CITS_MAX_PACKET_BYTES
        int "Maximum captured packet bytes"
        range 512 4096
        default 2352
        help
            Packets larger than this are dropped and counted in the drop stats.

    choice CITS_SERIAL_OUTPUT
        prompt "Packet output"
        default CITS_SERIAL_OUTPUT_USB_AND_SPI
        help
            Select where accepted packet records are written. All outputs use
            the same CTG1 COBS-delimited binary framing.

        config CITS_SERIAL_OUTPUT_USB
            bool "USB Serial/JTAG only"

        config CITS_SERIAL_OUTPUT_SPI
            bool "GPIO SPI only"

        config CITS_SERIAL_OUTPUT_USB_AND_SPI
            bool "USB Serial/JTAG and GPIO SPI"
    endchoice

    config CITS_SERIAL_WRITE_TIMEOUT_MS
        int "Serial write timeout in milliseconds"
        range 1 1000
        default 100

    config CITS_SPI_CLOCK_HZ
        int "GPIO SPI clock in Hz"
        range 100000 20000000
        default 4000000
        depends on CITS_SERIAL_OUTPUT_SPI || CITS_SERIAL_OUTPUT_USB_AND_SPI

    config CITS_SPI_CS_GPIO
        int "GPIO SPI CS GPIO"
        range 0 31
        default 0
        depends on CITS_SERIAL_OUTPUT_SPI || CITS_SERIAL_OUTPUT_USB_AND_SPI
        help
            XIAO ESP32-C5 D1 is GPIO0.

    config CITS_SPI_READY_GPIO
        int "GPIO SPI ready GPIO"
        range 0 31
        default 25
        depends on CITS_SERIAL_OUTPUT_SPI || CITS_SERIAL_OUTPUT_USB_AND_SPI
        help
            XIAO ESP32-C5 D2 is GPIO25. The uplink board drives this high
            when its SPI slave transaction buffer is ready.

    config CITS_SPI_MOSI_GPIO
        int "GPIO SPI MOSI GPIO"
        range 0 31
        default 7
        depends on CITS_SERIAL_OUTPUT_SPI || CITS_SERIAL_OUTPUT_USB_AND_SPI
        help
            XIAO ESP32-C5 D3 is GPIO7.

    config CITS_SPI_MISO_GPIO
        int "GPIO SPI MISO GPIO"
        range -1 31
        default 23
        depends on CITS_SERIAL_OUTPUT_SPI || CITS_SERIAL_OUTPUT_USB_AND_SPI
        help
            XIAO ESP32-C5 D4 is GPIO23. Set to -1 if MISO is not wired.

    config CITS_SPI_CLK_GPIO
        int "GPIO SPI clock GPIO"
        range 0 31
        default 24
        depends on CITS_SERIAL_OUTPUT_SPI || CITS_SERIAL_OUTPUT_USB_AND_SPI
        help
            XIAO ESP32-C5 D5 is GPIO24.

    config CITS_SPI_READY_TIMEOUT_MS
        int "SPI ready timeout in milliseconds"
        range 1 1000
        default 100
        depends on CITS_SERIAL_OUTPUT_SPI || CITS_SERIAL_OUTPUT_USB_AND_SPI

    config CITS_LED_GPIO
        int "USER LED GPIO"
        default 27
        help
            Seeed Studio XIAO ESP32-C5 USER LED is connected to GPIO27.

    config CITS_LED_ACTIVE_LOW
        bool "USER LED is active low"
        default y

    config CITS_LED_PULSE_MS
        int "Accepted packet LED pulse in milliseconds"
        range 1 1000
        default 35

endmenu
