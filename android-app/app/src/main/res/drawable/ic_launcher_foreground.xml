        android:scaleY="0.19"
        android:translateX="-210.5"
        android:translateY="-182">

        <!-- The C as a ring road, open 58 degrees above and below the signal. -->
        <path
            android:strokeColor="#1D2A48"
            android:strokeWidth="64"
            android:strokeLineCap="round"
            android:pathData="M324.9 346.2 A130 130 0 1 1 324.9 125.8" />

        <!--
            Dashed centre line of the ring: 22 px dashes with 20 px gaps from the start of the arc, the last
