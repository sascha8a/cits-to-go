# Copy this file to .env.release and fill in the real values.
# Do not commit .env.release or the keystore.

# Use an absolute path, for example:
# CITS_RELEASE_STORE_FILE=/home/you/.android/cits-to-go-release.jks
CITS_RELEASE_STORE_FILE=
CITS_RELEASE_STORE_PASSWORD=
CITS_RELEASE_KEY_ALIAS=cits-to-go
CITS_RELEASE_KEY_PASSWORD=
